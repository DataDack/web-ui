{
  "name": "serverless-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the serverless-faas web surfaces and the publishable UI packages they share.",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "config/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "build:admin": "nx build serverless-admin",
    "dev:admin": "nx dev serverless-admin",
    "preview:admin": "nx preview serverless-admin",
    "affected": "nx affected -t lint typecheck build",
    "graph": "nx graph",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "clean": "nx run-many -t clean && nx reset",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "nx run-many -t build --projects=tag:publishable && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "nx": "^23.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
