{
  "name": "serverless-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the serverless-faas web surfaces and the publishable UI packages they share.",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "config/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "build:admin": "nx build serverless-admin",
    "dev:admin": "nx dev serverless-admin",
    "preview:admin": "nx preview serverless-admin",
    "affected": "nx affected -t lint typecheck build",
    "graph": "nx graph",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "clean": "nx run-many -t clean && nx reset",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "nx run-many -t build --projects=tag:publishable && changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "36.0.0",
    "@codingame/monaco-vscode-configuration-service-override": "36.0.0",
    "@codingame/monaco-vscode-editor-api": "36.0.0",
    "@codingame/monaco-vscode-explorer-service-override": "36.0.0",
    "@codingame/monaco-vscode-files-service-override": "36.0.0",
    "@codingame/monaco-vscode-javascript-default-extension": "36.0.0",
    "@codingame/monaco-vscode-json-default-extension": "36.0.0",
    "@codingame/monaco-vscode-keybindings-service-override": "36.0.0",
    "@codingame/monaco-vscode-lifecycle-service-override": "36.0.0",
    "@codingame/monaco-vscode-python-default-extension": "36.0.0",
    "@codingame/monaco-vscode-quickaccess-service-override": "36.0.0",
    "@codingame/monaco-vscode-ruby-default-extension": "36.0.0",
    "@codingame/monaco-vscode-textmate-service-override": "36.0.0",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "36.0.0",
    "@codingame/monaco-vscode-theme-service-override": "36.0.0",
    "@codingame/monaco-vscode-typescript-basics-default-extension": "36.0.0",
    "@codingame/monaco-vscode-views-service-override": "36.0.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@vscode/diff": "0.0.2-40",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "5.7.0",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@codingame/esbuild-import-meta-url-plugin": "^1.0.3",
    "@serverless-ui/eslint-config": "workspace:*",
    "@serverless-ui/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "nx": "^23.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
