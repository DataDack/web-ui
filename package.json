{
  "name": "serverless-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the serverless-faas web surfaces and the publishable UI packages they share.",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "config/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build:admin": "nx build serverless-web",
    "dev:admin": "nx dev serverless-web",
    "preview:admin": "nx preview serverless-web",
    "build:cloud": "nx build cloud-react",
    "dev:cloud": "nx dev cloud-react",
    "preview:cloud": "nx preview cloud-react",
    "affected": "nx affected -t lint typecheck test build",
    "graph": "nx graph",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "clean": "nx run-many -t clean && nx reset",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "nx run-many -t build --projects=tag:publishable && changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.13.0",
    "@casl/ability": "^7.0.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/rubik": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@posthog/react": "^1.9.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@sentry/react": "^10.51.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-google-recaptcha": "^2.1.9",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "posthog-js": "^1.372.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.79.0",
    "react-i18next": "^17.0.8",
    "react-icons": "5.7.0",
    "react-router-dom": "^7.18.2",
    "react-timezone-select": "^3.3.3",
    "rehype-raw": "^7.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@happy-dom/global-registrator": "^20.10.6",
    "@serverless-ui/eslint-config": "workspace:*",
    "@serverless-ui/typescript-config": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "bun-types": "^1.3.13",
    "eslint": "^9.39.5",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nx": "^23.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "patchedDependencies": {
    "eslint-plugin-react@7.37.5": "patches/eslint-plugin-react@7.37.5.patch"
  },
  "overrides": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "zod-validation-error": "^4.0.2"
  }
}
