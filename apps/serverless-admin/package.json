{
  "name": "serverless-admin",
  "version": "0.0.0",
  "private": true,
  "description": "Admin console for the serverless-faas control plane.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "nx": {
    "tags": [
      "scope:app"
    ],
    "implicitDependencies": [
      "@serverless-ui/eslint-config",
      "@serverless-ui/typescript-config"
    ]
  },
  "dependencies": {
    "@datadack/serverless-ui": "workspace:*"
  }
}
