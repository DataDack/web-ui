{
  "name": "serverless-web",
  "version": "0.0.0",
  "private": true,
  "description": "Admin console for the serverless-faas control plane.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "clean": "rm -rf dist node_modules/.vite node_modules/.tmp"
  },
  "nx": {
    "tags": [
      "scope:app"
    ],
    "implicitDependencies": [
      "@serverless-ui/eslint-config",
      "@serverless-ui/typescript-config"
    ]
  },
  "dependencies": {
    "@DataDack/common-ui": "workspace:*",
    "@DataDack/serverless-ui": "workspace:*"
  }
}
