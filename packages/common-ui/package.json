{
  "name": "@datadack/common-ui",
  "version": "0.0.0",
  "private": true,
  "description": "DataDack design system: emotion-styled shadcn-derived primitives, console building blocks, charts and theme, shared by every web surface.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DataDack/web-ui.git",
    "directory": "packages/common-ui"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.0.0",
    "lucide-react": ">=1.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-icons": ">=5.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "nx": {
    "tags": [
      "scope:package"
    ],
    "implicitDependencies": [
      "@serverless-ui/eslint-config",
      "@serverless-ui/typescript-config"
    ]
  }
}
