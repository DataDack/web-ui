{
  "name": "@datadack/integration",
  "version": "0.1.0",
  "description": "Connected accounts and platform integrations UI for the automations section.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@datadack/workflows": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "lucide-react": ">=1.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": ">=7.0.0",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@datadack/workflows": "workspace:*",
    "tsup": "^8.5.0"
  },
  "nx": {
    "tags": [
      "scope:package",
      "publishable"
    ],
    "implicitDependencies": [
      "@serverless-ui/eslint-config",
      "@serverless-ui/typescript-config"
    ]
  }
}
