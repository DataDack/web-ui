# Editor-level baseline. Prettier owns formatting for the file types it
# handles; this covers everything else and every editor that has no plugin.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces is a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
